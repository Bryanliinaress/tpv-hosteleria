# Credenciales de Supabase (la anon key es pública/segura, protegida por RLS)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key

# EmailJS — correos de confirmación/recordatorio de reservas (claves públicas, frontend)
# Crea una cuenta en https://www.emailjs.com, un "Email Service" y un "Email Template"
# que use las variables {{to_email}}, {{asunto}} y {{mensaje}}.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Plantilla de EmailJS para mandar FACTURAS con el PDF adjunto. Va aparte de la
# de reservas porque tiene que llevar configurado un adjunto: en EmailJS,
# plantilla → pestaña «Attachments» → «Add Variable Attachment», parámetro
# `factura_pdf`, tipo PDF, nombre de archivo `{{nombre_archivo}}`. El cuerpo
# usa {{asunto}} y {{mensaje}} como la de reservas. No es un secreto.
# VITE_EMAILJS_TEMPLATE_FACTURA_ID=
