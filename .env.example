# Credenciales de Supabase (la anon key es pública/segura, protegida por RLS)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...tu-anon-key

# EmailJS — correos de confirmación/recordatorio de reservas (claves públicas, frontend)
# Crea una cuenta en https://www.emailjs.com, un "Email Service" y un "Email Template"
# que use las variables {{to_email}}, {{asunto}} y {{mensaje}}.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Las FACTURAS por correo (con el PDF adjunto) NO se configuran aquí: salen del
# servidor por Resend. Van como secretos de Supabase (Edge Functions → Secrets),
# nunca en este fichero ni en el repositorio:
#   RESEND_API_KEY    la clave de Resend
#   CORREO_REMITENTE  facturas@envios.tu-empresa.es (dominio verificado en Resend;
#                     el nombre visible es el del bar y las respuestas van a su correo)
